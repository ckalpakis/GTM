{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outbound-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  // Sending every 15 minutes; retention cleanup daily at 03:17 UTC.
  "triggers": {
    "crons": ["*/15 * * * *", "17 3 * * *"],
  },
  // Set both caps explicitly to enable sending. Daily windows use UTC.
  "vars": {
    "DAILY_SEND_CAP": "0",
    "MAX_SENDS_PER_RUN": "0",
    "SETTER_MODE": "draft",
    "CONTACT_RETENTION_SECONDS": "2592000",
    "OPENAI_MODEL": "gpt-4.1-mini",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outbound-agent",
      "database_id": "3e5784a6-bdd0-40b2-a1e9-7e2b2cc80c43",
      "migrations_dir": "migrations",
    },
  ],
}
